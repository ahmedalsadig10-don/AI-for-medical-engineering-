        "outputId": "061af972-53be-4694-92e1-96036d7eecca"
      },
      "source": [
        "from tenacity import retry, stop_after_attempt, wait_exponential, retry_if_exception_type\n",
        "import google.genai.errors\n",
        "\n",
        "# Define exponential backoff retry logic for CrewAI execution\n",
        "@retry(\n",
        "    stop=stop_after_attempt(7),                                     # Try up to 5 times\n",
        "    wait=wait_exponential(multiplier=1, min=2, max=10),              # Wait 2s, 4s, 8s...\n",
        "    retry=retry_if_exception_type(Exception),                       # Retry on any standard Exception\n",
        "    reraise=True                                                    # Raise the last exception if all retries fail\n",
        ")\n",
        "async def run_crew_with_retry(crew):\n",
        "    print(\"Starting crew execution with retry handling...\")\n",
        "    return await crew.kickoff_async()\n",
        "\n",
        "# Example usage with your crew\n",
        "try:\n",
        "    result = await run_crew_with_retry(research_crew)\n",
        "    print(\"######## SUCCESS ########\")\n",
        "    print(result)\n",
        "except Exception as e:\n",
        "    print(f\"Execution failed after retries: {e}\")"
      ],
